<+>/* =========================\r\n   Cards grid + Subgrid alignment\r\n   ========================= */\r\n\r\n.category-grid {\r\n    margin-top: var(--space-fluid);\r\n    display: grid;\r\n    gap: var(--gap-fluid);\r\n\r\n    grid-template-columns: repeat(auto-fit, minmax(min(18rem, 100%), 1fr));\r\n    align-items: stretch;\r\n}\r\n\r\n/* Fallback om inte subgrid fungerar */\r\n.card {\r\n    display: grid;\r\n    grid-template-rows: auto 1fr auto;\r\n    gap: 0.75rem;\r\n\r\n    padding: var(--space-fluid);\r\n    border-radius: var(--border-radius);\r\n\r\n    background-color: var(--surface);\r\n    border: 1px solid color-mix(in oklch, var(--border-muted) 60%, transparent);\r\n    box-shadow: var(--shadow-soft);\r\n    /*transition: ease-in-out 0.2s;*/\r\n\r\n    transition: background-color 180ms ease, border-color 180ms ease, box-shadow 180ms ease;\r\n}\r\n\r\n.card:hover {\r\n    /*transform: scale(var(--scale-on-hover)); */\r\n\r\n    background: var(--surface-hover);\r\n    border-color: var(--surface-border-hover);\r\n    box-shadow: var(--shadow);\r\n}\r\n\r\n.card-header h3 { color: var(--text); margin: 0; }\r\n.card-content p { margin: 0; }\r\n\r\n.card-link a {\r\n    display: inline-flex;\r\n    align-items: center;\r\n    gap: 0.35em;\r\n\r\n    font-weight: 700;\r\n    color: color-mix(in oklch, var(--primary) 85%, var(--text));\r\n}\r\n\r\n.card-link a:hover {\r\n    text-decoration: underline;\r\n}\r\n\r\n/*\r\n  Subgrid-enhancement (om browser stödjer):\r\n  Parent får \"3 rader per kort\", korten span:3 och använder subgrid.\r\n*/\r\n@supports (grid-template-rows: subgrid) {\r\n    .category-grid {\r\n        grid-auto-rows: auto;\r\n    }\r\n\r\n    .card {\r\n        grid-row: span 3;\r\n        grid-template-rows: subgrid;\r\n    }\r\n\r\n    .card-header { grid-row: 1; }\r\n    .card-content { grid-row: 2; }\r\n    .card-link { grid-row: 3; }\r\n}\r\n\r\n\r\n@media (prefers-reduced-motion: reduce) {\r\n    * { transition: none !important; animation: none !important; }\r\n}\r\n\r\n/* =========================\r\n   Concept section\r\n   ========================= */\r\n\r\n.concept-section{\r\n    margin-top: var(--space-fluid);\r\n    padding: var(--space-fluid);\r\n    border-radius: var(--border-radius);\r\n\r\n    background-color: var(--surface);\r\n    border: 1px solid color-mix(in oklch, var(--border-muted) 60%, transparent);\r\n    box-shadow: var(--shadow-soft);\r\n    /*transition: ease-in-out 0.2s;*/\r\n    transition: background-color 180ms ease, border-color 180ms ease, box-shadow 180ms ease;\r\n\r\n}\r\n\r\n.concept-section:hover {\r\n    /*transform: scale(var(--scale-on-hover));*/\r\n    /*border-color: var(--border-muted);*/\r\n    background: var(--surface-hover);\r\n    border-color: var(--surface-border-hover);\r\n    box-shadow: var(--shadow);\r\n}\r\n\r\n.concept-section p { color: color-mix(in oklch, var(--text) 85%, var(--text-muted)); }\r\n.concept-section strong { color: var(--text); }\r\n.concept-section h2 { color: var(--secondary); }\r\n\r\n\r\n/* =========================\r\n   kanpp för att byta tema\r\n   ========================= */\r\n\r\n.theme-toggle{\r\n    width: 2.4rem;\r\n    height: 2.4rem;\r\n    border-radius: 999px;\r\n    border: 1px solid var(--border);\r\n    background: color-mix(in oklch, var(--bg-light) 70%, transparent);\r\n    color: var(--text);\r\n    display: inline-grid;\r\n    place-items: center;\r\n    box-shadow: var(--shadow-soft);\r\n    cursor: pointer;\r\n    transition: transform 120ms ease;\r\n}\r\n\r\n.theme-toggle:hover{ transform: scale(var(--scale-on-hover)); }\r\n.theme-toggle:active{ transform: scale(0.98); }\r\n\r\n.lunch-menu .dish + .dish{\r\n    margin-top: 0.9rem;\r\n    padding-top: 0.9rem;\r\n    border-top: 1px solid color-mix(in oklch, var(--border-muted) 45%, transparent);\r\n}\r\n\r\n.lunch-menu h2 { margin: 0; }\r\n.lunch-menu h3 { margin: 0 0 0.25rem; color: var(--text); }\r\n\r\n.muted{\r\n    color: var(--text-muted);\r\n    margin-top: 1rem;\r\n}\r\n
