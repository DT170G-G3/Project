<+><!DOCTYPE html>\r\n<html xmlns=\"http://www.w3.org/1999/xhtml\"\r\n      xmlns:h=\"http://xmlns.jcp.org/jsf/html\"\r\n      xmlns:ui=\"http://xmlns.jcp.org/jsf/facelets\"\r\n      xmlns:f=\"http://xmlns.jcp.org/jsf/core\">\r\n\r\n<h:head>\r\n    <meta charset=\"UTF-8\"/>\r\n    <meta name=\"viewport\" content=\"width=device-width, initial-scale=1.0\"/>\r\n\r\n    <script>\r\n        (function () {\r\n            const saved = localStorage.getItem(\"theme\"); // \"dark\" | \"light\"\r\n            if (saved === \"dark\" || saved === \"light\") {\r\n                document.documentElement.dataset.theme = saved;\r\n            } else {\r\n            }\r\n        })();\r\n    </script>\r\n\r\n    <title>\r\n        <ui:insert name=\"title\">Anton's Skafferi</ui:insert>\r\n    </title>\r\n\r\n    <h:outputStylesheet library=\"css\" name=\"base.css?v=${build.version}\" />\r\n    <h:outputStylesheet library=\"css\" name=\"layout.css?v=${build.version}\" />\r\n    <h:outputStylesheet library=\"css\" name=\"components.css?v=${build.version}\" />\r\n    <h:outputStylesheet library=\"css\" name=\"landing.css?v=${build.version}\" />\r\n<!--    <h:outputStylesheet library=\"css\" name=\"style.css?v=${build.version}\" />-->\r\n\r\n    <ui:insert name=\"extra-head\" />\r\n</h:head>\r\n\r\n<h:body>\r\n    <header class=\"header full-width\">\r\n        <div class=\"logo\">\r\n            <h:link outcome=\"index\">Anton's Skafferi</h:link>\r\n\r\n            <button id=\"themeToggle\"\r\n                    type=\"button\"\r\n                    class=\"theme-toggle\"\r\n                    aria-label=\"Växla tema\"\r\n                    aria-pressed=\"false\">\r\n            \uD83C\uDF19\r\n            </button>\r\n        </div>\r\n\r\n        <nav class=\"nav-links\">\r\n            <h:link outcome=\"index\" value=\"Hem\" styleClass=\"nav-link #{view.viewId == '/index.xhtml' ? 'active' : ''}\"/>\r\n            <h:link outcome=\"lunch\" value=\"Lunch\" styleClass=\"nav-link #{view.viewId == '/lunch.xhtml' ? 'active' : ''}\"/>\r\n            <h:link outcome=\"menu\" value=\"Á La Carte\" styleClass=\"nav-link #{view.viewId == '/menu.xhtml' ? 'active' : ''}\"/>\r\n            <h:link outcome=\"booking\" value=\"Boka bord\" styleClass=\"nav-link #{view.viewId == '/booking.xhtml' ? 'active' : ''}\"/>\r\n            <h:link outcome=\"events\" value=\"Events\" styleClass=\"nav-link #{view.viewId == '/events.xhtml' ? 'active' : ''}\"/>\r\n        </nav>\r\n    </header>\r\n\r\n    <ui:insert name=\"hero\"/>\r\n<!--    sidor som man döper till name=\"content\" kommer att laddas här under-->\r\n    <main id=\"main-content\" class=\"main-container\">\r\n        <ui:insert name=\"content\">\r\n            <p>Innehåll saknas.</p>\r\n        </ui:insert>\r\n    </main>\r\n<!-- fram till hit..-->\r\n\r\n    <footer class=\"footer full-width\">\r\n        <div class=\"footer-inner\">\r\n            <p>© 2026 Anton's Skafferi</p>\r\n        </div>\r\n    </footer>\r\n\r\n    <script>\r\n        (function () {\r\n            const KEY = \"theme\";\r\n            const root = document.documentElement;\r\n            const btn = document.getElementById(\"themeToggle\");\r\n            if (!btn) return;\r\n\r\n            function apply(theme) {\r\n                root.dataset.theme = theme;\r\n                const isLight = theme === \"light\";\r\n                btn.setAttribute(\"aria-pressed\", String(isLight));\r\n                btn.textContent = isLight ? \"☀\uFE0F\" : \"\uD83C\uDF19\";\r\n            }\r\n            const saved = localStorage.getItem(KEY);\r\n            if (saved === \"dark\" || saved === \"light\") {\r\n                apply(saved);\r\n            } else {\r\n                const prefersLight = matchMedia(\"(prefers-color-scheme: light)\").matches;\r\n                apply(prefersLight ? \"light\" : \"dark\");\r\n                localStorage.setItem(KEY, prefersLight ? \"light\" : \"dark\");\r\n            }\r\n\r\n            btn.addEventListener(\"click\", () => {\r\n                const current = root.dataset.theme === \"light\" ? \"light\" : \"dark\";\r\n                const next = current === \"light\" ? \"dark\" : \"light\";\r\n                localStorage.setItem(KEY, next);\r\n                apply(next);\r\n            });\r\n        })();\r\n    </script>\r\n\r\n</h:body>\r\n</html>
