<+>\r\n/* Container helper */\r\n.main-container {\r\n    width: var(--container-width);\r\n    margin-inline: auto;\r\n    padding: var(--space-fluid) var(--padding-fluid);\r\n    background: var(--bg);\r\n    z-index: 1;\r\n    flex: 1;\r\n}\r\n\r\n/* =========================\r\n   Header (sticky)\r\n   ========================= */\r\n\r\n.header {\r\n    position: sticky;\r\n    top: 0;\r\n    z-index: 50;\r\n\r\n    min-height: var(--header-height);\r\n    display: flex;\r\n    align-items: center;\r\n    justify-content: space-between;\r\n    gap: var(--gap-fluid);\r\n\r\n    padding: calc(var(--padding-fluid) * 0.75) var(--padding-fluid);\r\n\r\n    background: color-mix(in oklch, var(--bg-dark) 75%, transparent);\r\n    border-bottom: 1px solid color-mix(in oklch, var(--border-muted) 60%, transparent);\r\n    backdrop-filter: blur(10px);\r\n}\r\n\r\n.footer{\r\n    margin-top: auto;\r\n    background: var(--bg-dark);\r\n    border-top: 1px solid color-mix(in oklch, var(--border-muted) 60%, transparent);\r\n}\r\n\r\n.footer-inner{\r\n    width: 100%;\r\n    margin-inline: auto;\r\n    padding: calc(var(--space-fluid) * 0.75) var(--padding-fluid);\r\n    text-align: center;\r\n    color: var(--text-muted);\r\n}\r\n\r\n.logo {\r\n    font-weight: 800;\r\n    letter-spacing: 0.02em;\r\n    color: var(--text);\r\n    font-size: var(--font-size-h3);\r\n\r\n    display: flex;\r\n    align-items: center;\r\n    gap: 0.65rem;\r\n}\r\n\r\n\r\n.nav-links {\r\n    display: flex;\r\n    flex-wrap: wrap;\r\n    gap: 0.4rem;\r\n}\r\n\r\n.nav-link {\r\n    position: relative;\r\n    padding: 0.55em 0.8em;\r\n    border-radius: 999px;\r\n    border: 1px solid transparent;\r\n    color: color-mix(in oklch, var(--text) 92%, transparent);\r\n    transition: color 0.3s ease;\r\n}\r\n\r\n.nav-link:hover {\r\n    background: color-mix(in oklch, var(--bg-light) 55%, transparent);\r\n    border-color: color-mix(in oklch, var(--border-muted) 60%, transparent);\r\n}\r\n\r\n/* Själva linjen */\r\n.nav-link.active::after {\r\n    content: \"\";\r\n    position: absolute;\r\n    bottom: 4px;      /* Hur långt ner från texten den ska ligga */\r\n    left: 0.8em;       /* Matchar din padding så linjen linjerar med texten */\r\n    right: 0.8em;\r\n    height: 2px;       /* Tjockleken du bad om */\r\n    background-color: var(--secondary);\r\n    border-radius: 2px;\r\n    box-shadow: 0 0 8px color-mix(in oklch, var(--secondary) 40%, transparent); /* Valfritt: ger ett litet \"glow\" */\r\n}\r\n\r\n/* Gör texten lite tydligare när den är aktiv */\r\n.nav-link.active {\r\n    color: var(--text);\r\n    font-weight: 600;\r\n}\r\n
