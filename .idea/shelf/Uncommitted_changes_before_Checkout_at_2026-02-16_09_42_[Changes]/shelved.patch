<+>/* =========================\r\n   Anton's Skafferi - Design Tokens\r\n   ========================= */\r\n\r\n/* dARK SOM Default */\r\n:root {\r\n    --bg-dark: oklch(0.1 0.025 264);\r\n    --bg: oklch(0.15 0.025 264);\r\n    --bg-light: oklch(0.2 0.025 264);\r\n\r\n    --text: oklch(0.96 0.05 264);\r\n    --text-muted: oklch(0.76 0.05 264);\r\n\r\n    --highlight: oklch(0.5 0.05 264);\r\n\r\n    --border: oklch(0.4 0.05 264);\r\n    --border-muted: oklch(0.3 0.05 264);\r\n\r\n    --primary: oklch(0.76 0.1 264);\r\n    --secondary: oklch(0.76 0.1 84);\r\n\r\n    --danger: oklch(0.7 0.05 30);\r\n    --warning: oklch(0.7 0.05 100);\r\n    --success: oklch(0.7 0.05 160);\r\n    --info: oklch(0.7 0.05 260);\r\n\r\n    /* Effects */\r\n    --shadow: 0 18px 55px rgba(0,0,0,0.35);\r\n    --shadow-soft: 0 10px 30px rgba(0,0,0,0.22);\r\n\r\n    --focus-ring: color-mix(in oklch, var(--primary) 60%, white);\r\n\r\n    /* Typography */\r\n    --font-size-base: clamp(1rem, 0.94rem + 0.35vw, 1.15rem);\r\n    --font-size-h1: clamp(2rem, 1.4rem + 2.6vw, 3.25rem);\r\n    --font-size-h2: clamp(1.4rem, 1.15rem + 1.2vw, 2.1rem);\r\n    --font-size-h3: clamp(1.1rem, 1.0rem + 0.7vw, 1.45rem);\r\n\r\n    /* Spacing  */\r\n    --padding-fluid: clamp(0.9rem, 0.6rem + 1.1vw, 1.6rem);\r\n    --gap-fluid: clamp(0.75rem, 0.5rem + 1vw, 1.35rem);\r\n    --space-fluid: clamp(1.2rem, 0.9rem + 1.6vw, 2.6rem);\r\n\r\n    /* Layout */\r\n    --container-width: clamp(20rem, 92vw, 81.25rem);\r\n    --border-radius: clamp(0.85rem, 0.7rem + 0.7vw, 1.25rem);\r\n\r\n    --header-height: clamp(3.8rem, 3.3rem + 1.2vw, 4.6rem);\r\n    --footer-height: clamp(3.5rem, 3rem + 1vw, 4.2rem);\r\n    --hero-height: clamp(22rem, 42vh, 34rem);\r\n\r\n\r\n    /* Scale */\r\n    --scale-on-hover: 1.015;\r\n\r\n    --surface: color-mix(in oklch, var(--bg-light) 28%, transparent);\r\n    --surface-hover: color-mix(in oklch, var(--bg-light) 40%, transparent);\r\n    --surface-border: color-mix(in oklch, var(--border-muted) 60%, transparent);\r\n    --surface-border-hover: var(--border-muted);\r\n\r\n    color-scheme: dark;\r\n}\r\n\r\n/* LIGHT MODE */\r\n\r\n:root[data-theme=\"light\"] {\r\n    --bg-dark: oklch(0.95 0.01 264);\r\n    --bg: oklch(0.985 0.008 264);\r\n    --bg-light: oklch(0.995 0.006 264);\r\n\r\n    --text: oklch(0.2 0.02 264);\r\n    --text-muted: oklch(0.42 0.02 264);\r\n\r\n    --highlight: oklch(0.9 0.02 264);\r\n\r\n    --border: oklch(0.8 0.02 264);\r\n    --border-muted: oklch(0.88 0.015 264);\r\n\r\n    --primary: oklch(0.48 0.12 264);\r\n    --secondary: oklch(0.52 0.12 84);\r\n\r\n    --danger: oklch(0.52 0.12 30);\r\n    --warning: oklch(0.56 0.12 100);\r\n    --success: oklch(0.5 0.1 160);\r\n    --info: oklch(0.5 0.1 260);\r\n\r\n    --shadow: 0 18px 55px rgba(0, 0, 0, 0.12);\r\n    --shadow-soft: 0 10px 30px rgba(0, 0, 0, 0.08);\r\n\r\n    --focus-ring: color-mix(in oklch, var(--primary) 55%, black);\r\n\r\n    --surface: color-mix(in oklch, var(--bg-dark) 55%, var(--bg));\r\n    --surface-hover: color-mix(in oklch, var(--bg-dark) 70%, var(--bg));\r\n    --surface-border-hover: var(--border);\r\n\r\n    color-scheme: light;\r\n}\r\n\r\n\r\n/* =========================\r\n   Base / Reset\r\n   ========================= */\r\n\r\n* { box-sizing: border-box; }\r\n\r\nhtml, body {\r\n    height: 100%;\r\n    /*scrollbar-gutter: stable;*/\r\n    background-color: var(--bg);\r\n    overflow-x: hidden;\r\n}\r\n\r\nbody {\r\n    margin: 0;\r\n    font-size: var(--font-size-base);\r\n    line-height: 1.55;\r\n    color: var(--text);\r\n    font-family: system-ui, -apple-system, Segoe UI, Roboto, Arial, sans-serif;\r\n    /*background: var(--bg);*/\r\n    background-color: transparent;\r\n    display: flex;\r\n    flex-direction: column;\r\n    min-height: 100vh;\r\n\r\n}\r\n\r\nh1, h2, h3 { margin: 0 0 0.5em; line-height: 1.1; }\r\nh1 { font-size: var(--font-size-h1); }\r\nh2 { font-size: var(--font-size-h2); }\r\nh3 { font-size: var(--font-size-h3); }\r\n\r\np { margin: 0 0 1em; color: var(--text-muted); }\r\n\r\na {\r\n    color: inherit;\r\n    text-decoration: none;\r\n}\r\n\r\na:focus-visible,\r\nbutton:focus-visible,\r\ninput:focus-visible {\r\n    outline: 3px solid var(--focus-ring);\r\n    outline-offset: 3px;\r\n    border-radius: 0.65rem;\r\n}\r\n\r\n.full-width {\r\n    width: 100vw;\r\n    margin-left: calc(50% - 50vw);\r\n}\r\n
