<+>\r\n/* =========================\r\n   Hero med bild animation\r\n   ========================= */\r\n\r\n.hero{\r\n    width: 100%;\r\n    min-height: clamp(40vh, 50vh, 90vh);\r\n    position: relative;\r\n    overflow: hidden;\r\n    background: var(--bg-dark);\r\n    display: grid;\r\n    place-items: center;\r\n    text-align: center;\r\n    padding: var(--space-fluid);\r\n}\r\n\r\n/* Bildlager */\r\n.hero-slides{\r\n    position: absolute;\r\n    inset: 0;\r\n    z-index: 0;\r\n}\r\n\r\n.hero-slide{\r\n    position: absolute;\r\n    inset: 0;\r\n    background-position: center;\r\n    background-size: cover;\r\n    background-repeat: no-repeat;\r\n    /*background-attachment: fixed; */\r\n\r\n    opacity: 0;\r\n    /* ändra duration här, fint om det är jämnt delbart på antal bildder) */\r\n    animation: heroFade 40s ease-in-out infinite;\r\n}\r\n\r\n/* Bilder för animation */\r\n.hero-slide.s1{ background-image: url(\"#{resource['images:burgers.jpeg']}\"); }\r\n.hero-slide.s2{ background-image: url(\"#{resource['images:Drink-picture.jpg']}\"); }\r\n.hero-slide.s3{ background-image: url(\"#{resource['images:bottles-picture.jpg']}\"); }\r\n.hero-slide.s4{ background-image: url(\"#{resource['images:fish.jpg']}\"); }\r\n\r\n/* Förskjut tiden för att matcha antalet bilder mot animationen */\r\n.hero-slide.s1{ animation-delay: 0s; }\r\n.hero-slide.s2{ animation-delay: 10s; }\r\n.hero-slide.s3{ animation-delay: 20s; }\r\n.hero-slide.s4{ animation-delay: 30s; }\r\n\r\n/* Fade-form */\r\n@keyframes heroFade{\r\n    0%      { opacity: 0; }\r\n    10%     { opacity: 1; }\r\n    28%     { opacity: 1; }\r\n    35%     { opacity: 0; }\r\n    100%    { opacity: 0; }\r\n}\r\n\r\n/* Gradient overlay (alltid ovanpå bilderna) */\r\n.hero-overlay{\r\n    position: absolute;\r\n    inset: 0;\r\n    z-index: 1;\r\n    pointer-events: none;\r\n\r\n    background: linear-gradient(\r\n            to bottom,\r\n            rgba(0,0,0,0.15) 0%,\r\n            rgba(0,0,0,0.25) 45%,\r\n            var(--bg-dark) 100%\r\n    );\r\n}\r\n\r\n/* Innehåll ovanpå allt i hero */\r\n.hero-inner{\r\n\r\n    /*glaseffekt*/\r\n    background: rgba(0,0,0,0.10);\r\n    backdrop-filter: blur(5px);\r\n    -webkit-backdrop-filter: blur(12px);\r\n    border-radius: var(--border-radius);\r\n\r\n\r\n    position: relative;\r\n    z-index: 2;\r\n\r\n    display: grid;\r\n    place-items: center;\r\n    padding: var(--space-fluid) var(--padding-fluid);\r\n    max-width: var(--container-width);\r\n}\r\n\r\n/* Reduced motion */\r\n@media (prefers-reduced-motion: reduce){\r\n    .hero-slide{ animation: none; }\r\n    .hero-slide.s1{ opacity: 1; } /* visa bara första bilden */\r\n    .hero-slide:not(.s1){ opacity: 0; }\r\n}\r\n\r\n.hero-inner h1 {\r\n    color: var(--secondary);\r\n    text-shadow:\r\n            1px 1px 3px rgba(0,0,0,0.8),\r\n            0 10px 30px rgba(0,0,0,0.5);\r\n    margin-bottom: 0.35em;\r\n}\r\n\r\n.hero-inner p {\r\n    max-width: 60ch;\r\n    margin-inline: auto;\r\n    color: var(--text);\r\n    margin-bottom: 1.2em;\r\n}\r\n\r\n\r\n.hero-btn {\r\n    display: inline-flex;\r\n    align-items: center;\r\n    justify-content: center;\r\n\r\n    padding: 0.85em 1.15em;\r\n    border-radius: 999px;\r\n\r\n    background: linear-gradient(135deg, var(--primary), color-mix(in oklch, var(--secondary) 55%, var(--primary)));\r\n    color: oklch(0.12 0.02 264);\r\n\r\n    border: 1px solid color-mix(in oklch, var(--primary) 40%, var(--border));\r\n    box-shadow: var(--shadow-soft);\r\n\r\n    font-weight: 700;\r\n}\r\n\r\n.hero-btn:hover {\r\n    transform: translateY(-1px);\r\n}\r\n\r\n/* Credits till respektive bild */\r\n.hero-credits {\r\n    position: absolute;\r\n    bottom: 20px;\r\n    right: 20px;\r\n    z-index: 10;\r\n    /*pointer-events: none;*/\r\n}\r\n\r\n.hero-credit {\r\n    position: absolute;\r\n    bottom: 0;\r\n    right: 0;\r\n    white-space: nowrap;\r\n    color: rgba(255, 255, 255, 0.7);\r\n    font-size: 0.8rem;\r\n    font-family: sans-serif;\r\n\r\n    opacity: 0;\r\n    /*Denna duration MÅSTE vara samma som animationen för bilderna*/\r\n    animation: heroFade 40s ease-in-out infinite;\r\n}\r\n\r\n/* Matchar delay som bildern har */\r\n.hero-credit.c1 { animation-delay: 0s; }\r\n.hero-credit.c2 { animation-delay: 10s; }\r\n.hero-credit.c3 { animation-delay: 20s; }\r\n.hero-credit.c4 { animation-delay: 30s; }\r\n\r\n\r\n\r\n
